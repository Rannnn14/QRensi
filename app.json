{
  "expo": {
    "name": "QRensi",
    "slug": "QRensi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo1.png",
    "splash": {
      "image": "./assets/images/Logo1.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "qrensi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qrensi.app"
    },
    "android": {
      "package": "com.qrensi.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Logo1.png",
        "backgroundImage": "./assets/images/Logo1.png",
        "monochromeImage": "./assets/images/Logo1.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/Logo1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo1.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/Logo1.png",
            "backgroundColor": "#16324F"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo"
          ],
          "savePhotosPermission": "Izinkan QRensi menyimpan QR ke galeri perangkat."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92da5892-dff6-42f9-b9ab-eb008a3540fa"
      }
    },
    "owner": "qihh"
  }
}
